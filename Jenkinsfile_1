```groovy
pipeline {

    agent any

    environment {
        APP_NAME    = 'fullstack-project'
        GIT_BRANCH  = 'main'

        FRONTEND    = 'frontend'
        BACKEND     = 'backend'

        DEPLOY_USER = 'ubuntu'
        DEPLOY_HOST = '54.234.37.212'
        DEPLOY_PATH = '/home/ubuntu/fullstack-project'
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/Gurraiah123/fullstack-project.git',
                        credentialsId: 'github'
                    ]]
                ])
            }
        }

        stage('Frontend Install') {
            steps {
                dir("${FRONTEND}") {
                    sh '''
                        set -e
                        echo "Installing frontend dependencies..."
                        npm install
                    '''
                }
            }
        }

        stage('Frontend Build') {
            steps {
                dir("${FRONTEND}") {
                    sh '''
                        set -e
                        echo "Building frontend..."
                        npm run build
                    '''
                }
            }
        }

        stage('Backend Install & Test') {
            steps {
                dir("${BACKEND}") {
                    sh '''
                        set -e

                        echo "Creating Python virtual environment..."
                        python3 -m venv venv

                        . venv/bin/activate

                        echo "Installing Python dependencies..."
                        pip install --upgrade pip
                        pip install -r requirements.txt

                        echo "Backend dependency installation completed."
                    '''
                }
            }
        }

        stage('Docker Compose Validate') {
            steps {
                sh '''
                    set -e

                    echo "Validating Docker Compose..."
                    docker compose config
                '''
            }
        }

        stage('Docker Build Test') {
            steps {
                sh '''
                    set -e

                    echo "Building Docker images..."
                    docker compose build --no-cache

                    echo "Docker build completed successfully."
                '''
            }
        }

        stage('Test EC2 SSH') {
            steps {
                sshagent(credentials: ['ec2-ssh']) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Testing EC2 SSH Connection"
                        echo "======================================"

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -o UserKnownHostsFile=/dev/null \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            'hostname && whoami && docker --version && docker compose version'

                        echo "======================================"
                        echo "EC2 SSH Test Successful"
                        echo "======================================"
                    '''
                }
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(credentials: ['ec2-ssh']) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Starting EC2 Deployment"
                        echo "======================================"

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -o UserKnownHostsFile=/dev/null \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "cd ${DEPLOY_PATH} && \
                             git fetch origin ${GIT_BRANCH} && \
                             git reset --hard origin/${GIT_BRANCH} && \
                             docker compose down && \
                             docker container prune -f && \
                             docker compose build && \
                             docker compose up -d && \
                             sleep 10 && \
                             docker compose ps && \
                             docker image prune -f"

                        echo "======================================"
                        echo "Deployment Completed Successfully"
                        echo "======================================"
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sshagent(credentials: ['ec2-ssh']) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Verifying Deployment"
                        echo "======================================"

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -o UserKnownHostsFile=/dev/null \
                            "${DEPLOY_USER}@${DEPLOY_HOST}" \
                            "cd ${DEPLOY_PATH} && \
                             echo 'Container Status:' && \
                             docker compose ps && \
                             echo 'Docker Status:' && \
                             docker ps --format 'table {{.Names}}\\t{{.Status}}\\t{{.Ports}}'"

                        echo "======================================"
                        echo "Deployment Verification Completed"
                        echo "======================================"
                    '''
                }
            }
        }
    }

    post {

        success {
            echo '======================================'
            echo 'Pipeline Completed Successfully'
            echo '======================================'
        }

        failure {
            echo '======================================'
            echo 'Pipeline Failed'
            echo 'Check Jenkins console output'
            echo '======================================'
        }

        always {
            cleanWs()
        }
    }
}
