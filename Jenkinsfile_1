pipeline {

    agent any

    environment {
        APP_NAME    = "fullstack-project"
        GIT_BRANCH  = "main"

        FRONTEND    = "frontend"
        BACKEND     = "backend"

        DEPLOY_USER = "ubuntu"
        DEPLOY_HOST = "54.234.37.212"
        DEPLOY_PATH = "/home/ubuntu/fullstack-project"
    }

    stages {

        stage('Clean Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                git(
                    branch: "${main}",
                    url: "https://github.com/Gurraiah123/fullstack-project.git"
                )
            }
        }

        stage('Frontend Install') {
            steps {
                dir("${FRONTEND}") {
                    sh '''
                        set -e
                        npm install
                    '''
                }
            }
        }

        stage('Frontend Build') {
            steps {
                dir("${FRONTEND}") {
                    sh '''
                        set -e
                        npm run build
                    '''
                }
            }
        }

        stage('Backend Install & Test') {
            steps {
                dir("${BACKEND}") {
                    sh '''
                        set -e

                        python3 -m venv venv

                        . venv/bin/activate

                        pip install --upgrade pip
                        pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Docker Compose Validate') {
            steps {
                sh '''
                    set -e

                    docker compose config
                '''
            }
        }

        stage('Docker Build Test') {
            steps {
                sh '''
                    set -e

                    docker compose build --no-cache
                '''
            }
        }

        stage('Test EC2 SSH') {
            steps {
                sshagent(credentials: ['ec2-ssh']) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Testing EC2 SSH Connection"
                        echo "======================================"

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -o UserKnownHostsFile=/dev/null \
                            ubuntu@54.234.37.212 \
                            'hostname && whoami && docker --version && docker compose version'

                        echo "======================================"
                        echo "EC2 SSH Test Successful"
                        echo "======================================"
                    '''
                }
            }
        }

        stage('Deploy to EC2') {
            steps {
                sshagent(credentials: ['ec2-ssh']) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Connecting to EC2"
                        echo "======================================"

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -o UserKnownHostsFile=/dev/null \
                            ${DEPLOY_USER}@${DEPLOY_HOST} << EOF

                        set -e

                        echo "======================================"
                        echo "Starting Deployment"
                        echo "======================================"

                        cd ${DEPLOY_PATH}

                        echo "Current directory:"
                        pwd

                        echo "Pulling latest code..."

                        git fetch origin ${main}
                        git reset --hard origin/${main}

                        echo "Stopping old containers..."

                        docker compose down

                        echo "Removing unused containers..."

                        docker container prune -f

                        echo "Building latest Docker images..."

                        docker compose build

                        echo "Starting application..."

                        docker compose up -d

                        echo "Waiting for containers..."

                        sleep 10

                        echo "Container status:"

                        docker compose ps

                        echo "Docker images:"

                        docker images

                        echo "Cleaning unused Docker images..."

                        docker image prune -f

                        echo "======================================"
                        echo "Deployment Completed Successfully"
                        echo "======================================"

                        EOF
                    '''
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sshagent(credentials: ['ec2-ssh']) {
                    sh '''
                        set -e

                        echo "======================================"
                        echo "Verifying Deployment"
                        echo "======================================"

                        ssh \
                            -o StrictHostKeyChecking=no \
                            -o UserKnownHostsFile=/dev/null \
                            ${DEPLOY_USER}@${DEPLOY_HOST} << EOF

                        set -e

                        cd ${DEPLOY_PATH}

                        echo "Checking running containers..."

                        docker compose ps

                        echo "Checking Docker container health..."

                        docker ps --format "table {{.Names}}\\t{{.Status}}\\t{{.Ports}}"

                        echo "======================================"
                        echo "Deployment Verification Completed"
                        echo "======================================"

                        EOF
                    '''
                }
            }
        }
    }

    post {

        success {
            echo '======================================'
            echo 'Pipeline Completed Successfully'
            echo '======================================'
        }

        failure {
            echo '======================================'
            echo 'Pipeline Failed'
            echo 'Check Jenkins console output'
            echo '======================================'
        }

        always {
            cleanWs()
        }
    }
}
